    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT \n  CASE \n    WHEN NOT EXISTS (SELECT 1 FROM invite_codes WHERE code = $1) \n      THEN 'invalid'\n    WHEN EXISTS (SELECT 1 FROM invite_codes WHERE code = $1 AND used = true) \n      THEN 'used'\n    ELSE 'valid'\n  END as status;",
        "options": {
          "queryReplacement": "={{ $json.code }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.3,
      "position": [
        448,
        0
      ],
      "id": "6b3bbf5d-5333-4415-ae22-0485af6b01c5",
      "name": "Execute a SQL query",
      "credentials": {
        "postgres": {
          "id": "yPSJ6t0yTl3JfbWz",
          "name": "PostgresSQL Credential"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const status = $input.first().json.status;\nreturn [{\n  json: {\n    ok: status === 'valid',\n    msg: status === 'invalid' ? 'Invite code does not exist.' :\n         status === 'used' ? 'Invite code already redeemed.' : undefined\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        0
      ],
      "id": "44fa760d-e527-4467-988f-0b4264788d8e",
