        "subject": "MySweetPea - Account Suspended",
        "emailFormat": "html",
        "html": "=<!DOCTYPE html>\n<html lang=\"en\" xmlns:v=\"urn:schemas-microsoft-com:vml\" xmlns:o=\"urn:schemas-microsoft-com:office:office\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<meta http-equiv=\"X-UA-Compatible\" content=\"IE=edge\">\n<meta name=\"x-apple-disable-message-reformatting\">\n<title>MySweetPea</title>\n<!--[if mso]>\n<noscript><xml><o:OfficeDocumentSettings><o:PixelsPerInch>96</o:PixelsPerInch></o:OfficeDocumentSettings></xml></noscript>\n<![endif]-->\n</head>\n<body style=\"margin:0;padding:0;background-color:#0A1214;font-family:Arial,Helvetica,sans-serif;-webkit-text-size-adjust:100%;-ms-text-size-adjust:100%;\">\n  <!-- Preheader: hidden preview text shown in the inbox list -->\n  <div style=\"display:none;font-size:1px;line-height:1px;max-height:0;max-width:0;opacity:0;overflow:hidden;mso-hide:all;\">\n    Your account was suspended for security — contact us to reactivate.&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;\n  </div>\n  <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" bgcolor=\"#0A1214\" style=\"width:100%;background-color:#0A1214;\">\n    <tr>\n      <td align=\"center\" style=\"padding:40px 20px;\">\n        <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"width:100%;max-width:560px;background-color:#0F1A1C;border:1px solid #1E3336;border-radius:16px;\">\n          <!-- Header -->\n          <tr>\n            <td align=\"center\" bgcolor=\"#0F1A1C\" style=\"background-color:#0F1A1C;background:linear-gradient(135deg,#0F1A1C,#0A1214);padding:40px 32px 24px;border-bottom:1px solid #16282B;\">\n              <div style=\"font-size:28px;font-weight:700;color:#5EB8A8;letter-spacing:-0.5px;\">MySweetPea</div>\n              <div style=\"font-size:13px;color:#7A9B95;margin-top:4px;\">Self-hosted with care</div>\n            </td>\n          </tr>\n          <!-- Body -->\n          <tr>\n            <td style=\"padding:32px;\">\n              <h1 style=\"margin:0 0 16px;font-size:20px;font-weight:600;color:#F0F8F6;\">Account suspended 🔒</h1><p style=\"margin:0 0 24px;font-size:15px;line-height:1.7;color:#7A9B95;\">Hi {{ $json.name }},</p><p style=\"margin:0 0 24px;font-size:15px;line-height:1.7;color:#7A9B95;\">Your MySweetPea account has been temporarily suspended because your temporary password was not changed within 14 days.</p><table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" bgcolor=\"#1C1416\" style=\"background-color:#1C1416;border:1px solid #3A1E20;border-radius:8px;margin-bottom:24px;\">\n      <tr><td style=\"padding:14px 18px;font-size:13px;color:#E85E5E;line-height:1.6;\">🔒 This is a security measure. Your data is safe — you just need to contact us to reactivate your account.</td></tr>\n    </table><p style=\"margin:0 0 24px;font-size:15px;line-height:1.7;color:#7A9B95;\">To reactivate your account, please contact support and we'll help you get back online.</p><table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\">\n      <tr>\n        <td align=\"center\" style=\"padding:8px 0 24px;\">\n          <!--[if mso]>\n          <v:roundrect xmlns:v=\"urn:schemas-microsoft-com:vml\" xmlns:w=\"urn:schemas-microsoft-com:office:word\" href=\"mailto:support@mysweetpea.cc\" style=\"height:48px;v-text-anchor:middle;width:240px;\" arcsize=\"12%\" stroke=\"f\" fillcolor=\"#5EB8A8\">\n            <w:anchorlock/>\n            <center style=\"color:#0A1214;font-family:Arial,Helvetica,sans-serif;font-size:15px;font-weight:600;\">Contact Support</center>\n          </v:roundrect>\n          <![endif]-->\n          <!--[if !mso]><!-->\n          <a href=\"mailto:support@mysweetpea.cc\" style=\"display:inline-block;padding:14px 40px;background-color:#5EB8A8;color:#0A1214;font-size:15px;font-weight:600;text-decoration:none;border-radius:10px;\">Contact Support</a>\n          <!--<![endif]-->\n        </td>\n      </tr>\n    </table><p style=\"margin:margin:0;;font-size:15px;line-height:1.7;color:#7A9B95;\">Email: support@mysweetpea.cc</p>\n            </td>\n          </tr>\n          <!-- Footer -->\n          <tr>\n            <td style=\"padding:24px 32px;border-top:1px solid #16282B;text-align:center;\">\n              <p style=\"margin:0;font-size:12px;color:#4A6B65;line-height:18px;\">© 2026 MySweetPea. Self-hosted with care.</p>\n              \n            </td>\n          </tr>\n        </table>\n        <p style=\"margin:16px 0 0;font-family:Arial,Helvetica,sans-serif;font-size:12px;line-height:18px;color:#4A6B65;text-align:center;\">Private, self-hosted, community-funded infrastructure.</p>\n      </td>\n    </tr>\n  </table>\n</body>\n</html>",
