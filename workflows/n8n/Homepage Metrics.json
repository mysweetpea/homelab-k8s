      "parameters": {
        "jsCode": "const workflows = $(\"Get many workflows\").all();\nconst executions = $(\"Get many executions\").all();\n\nconst now = Date.now();\nconst cutoff = now - 24 * 60 * 60 * 1000;\n\nlet exec24h = 0;\nlet failed24h = 0;\n\nfor (const item of executions) {\n  const e = item.json;\n  const ts = new Date(e.startedAt || e.createdAt || e.stoppedAt).getTime();\n  if (ts > cutoff) {\n    exec24h++;\n    if (e.status === 'error') failed24h++;\n  }\n}\n\n// CRITICAL: Code node v2 requires returning an ARRAY of items\nreturn [{\n  json: {\n    workflows: workflows.length,\n    executions_24h: exec24h,\n    failed_24h: failed24h\n  }\n}];"
      },
