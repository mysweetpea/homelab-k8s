      "parameters": {
        "jsCode": "const d = $input.first().json.body || {};\nlet err = null;\nif (!d.name || d.name.trim().length < 2) err = 'Name is required (min 2 characters)';\nelse if (!d.email || !/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(d.email.trim())) err = 'Valid email is required';\nelse if (!d.services || d.services.trim().length < 2) err = 'Please list the services you want';\n// Form does not send a username - generate a unique placeholder from the email\nconst base = (d.email || '').split('@')[0].toLowerCase().replace(/[^a-z0-9_]/g, '_').slice(0, 20) || 'user';\nd.username = base + '_' + Math.random().toString(36).slice(2, 6);\nreturn [{json: {...d, validation_error: err}}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
