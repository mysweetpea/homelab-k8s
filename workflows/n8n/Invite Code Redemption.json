    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id, code, tier, used,\n  CASE WHEN used = false THEN true ELSE false END as valid,\n  CASE WHEN used = true THEN 'Invite code already redeemed.' ELSE 'Invite code is valid.' END as msg\nFROM invite_codes WHERE code = $1\nUNION ALL\nSELECT NULL::int, NULL::text, NULL::text, false, false, 'Invite code not found.'\nWHERE NOT EXISTS (SELECT 1 FROM invite_codes WHERE code = $2);",
        "options": {
          "queryReplacement": "={{ $json.invite_code }}, {{ $json.invite_code }}"
        }
      },
