        "html": "=<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Welcome to MySweetPea</title>\n</head>\n<body style=\"margin:0;padding:0;background:#0A1214;font-family:'Inter',-apple-system,BlinkMacSystemFont,'Segoe UI',system-ui,sans-serif;\">\n  <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#0A1214;min-height:100vh;\">\n    <tr>\n      <td align=\"center\" style=\"padding:40px 20px;\">\n        <table width=\"560\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#0F1A1C;border:1px solid rgba(94,184,168,0.15);border-radius:16px;overflow:hidden;max-width:560px;\">\n          <tr>\n            <td style=\"background:linear-gradient(135deg,#0F1A1C,#0A1214);padding:40px 32px 24px;text-align:center;border-bottom:1px solid rgba(94,184,168,0.08);\">\n              <div style=\"font-size:28px;font-weight:700;color:#5EB8A8;letter-spacing:-0.5px;\">MySweetPea</div>\n              <div style=\"font-size:13px;color:#7A9B95;margin-top:4px;\">Self-hosted with care</div>\n            </td>\n          </tr>\n          <tr>\n            <td style=\"padding:32px;\">\n              <h1 style=\"margin:0 0 16px;font-size:20px;font-weight:600;color:#F0F8F6;\">Your account has been created! 🌸</h1>\n              <p style=\"margin:0 0 24px;font-size:15px;line-height:1.7;color:#7A9B95;\">Hi {{ $('Validate Input').item.json.name }},</p>\n              <p style=\"margin:0 0 24px;font-size:15px;line-height:1.7;color:#7A9B95;\">Your MySweetPea account has been created successfully. All services use Single Sign-On (SSO) through Authentik. Use the credentials below to log in.</p>\n              <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#0A1214;border:1px solid rgba(94,184,168,0.12);border-radius:10px;margin-bottom:24px;\">\n                <tr>\n                  <td style=\"padding:20px 24px;\">\n                    <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\">\n                      <tr><td style=\"font-size:13px;color:#4A6B65;padding-bottom:12px;border-bottom:1px solid rgba(94,184,168,0.06);\">SSO PORTAL</td></tr>\n                      <tr><td style=\"padding:12px 0;font-size:15px;color:#F0F8F6;\"><a href=\"https://auth.mysweetpea.cc\" style=\"color:#5EB8A8;text-decoration:none;font-weight:600;\">https://auth.mysweetpea.cc</a></td></tr>\n                      <tr><td style=\"font-size:13px;color:#4A6B65;padding-top:8px;padding-bottom:4px;\">USERNAME</td></tr>\n                      <tr><td style=\"padding:4px 0;font-size:15px;color:#F0F8F6;font-family:monospace;\">{{ $('Validate Input').item.json.username }}</td></tr>\n                      <tr><td style=\"font-size:13px;color:#4A6B65;padding-top:8px;padding-bottom:4px;\">TEMPORARY PASSWORD</td></tr>\n                      <tr><td style=\"padding:4px 0;font-size:15px;color:#5ED39E;font-family:monospace;font-weight:600;\">{{ $('Generate Temp Password').item.json.temp_password }}</td></tr>\n                    </table>\n                  </td>\n                </tr>\n              </table>\n              <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\">\n                <tr><td align=\"center\" style=\"padding:8px 0 24px;\"><a href=\"https://auth.mysweetpea.cc\" style=\"display:inline-block;padding:14px 40px;background:linear-gradient(135deg,#5EB8A8,#3E8E86);color:#0A1214;font-size:15px;font-weight:600;text-decoration:none;border-radius:10px;\">Log In to Authentik</a></td></tr>\n              </table>\n              <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:rgba(232,94,94,0.06);border:1px solid rgba(232,94,94,0.15);border-radius:8px;margin-bottom:24px;\">\n                <tr><td style=\"padding:14px 18px;font-size:13px;color:#E85E5E;line-height:1.6;\">⚠️ Please log in and change your password immediately under User Settings.</td></tr>\n              </table>\n              <p style=\"margin:0;font-size:13px;color:#4A6B65;line-height:1.6;\">If you have any questions, reply to this email or contact support@mysweetpea.cc.</p>\n            </td>\n          </tr>\n          <tr><td style=\"padding:24px 32px;border-top:1px solid rgba(94,184,168,0.06);text-align:center;\"><p style=\"margin:0;font-size:12px;color:#4A6B65;\">© 2026 MySweetPea. Self-hosted with care.</p></td></tr>\n        </table>\n      </td>\n    </tr>\n  </table>\n</body>\n</html>",
