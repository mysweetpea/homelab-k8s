    {
      "parameters": {
        "jsCode": "const d = $input.first().json.body || {};\n\nconst inviteCode = String(d.invite_code || '').trim();\n\nlet err = null;\n\nif (!/^(PEA|FAM)-[A-Z0-9]{8}$/.test(inviteCode)) {\n  err = 'Invalid invite code format. Use PEA-7KJXU2YK or FAM-9YG7JQ5T.';\n} else if (!d.name || d.name.trim().length < 2) {\n  err = 'Name is required (minimum 2 characters).';\n} else if (!d.email || !/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(d.email.trim())) {\n  err = 'A valid email address is required.';\n} else if (!d.username || !/^[a-zA-Z0-9_]{3,}$/.test(d.username.trim())) {\n  err = 'Username must be at least 3 characters and use only letters, numbers, or underscores.';\n}\n\nreturn [{\n  json: {\n    ...d,\n    invite_code: inviteCode,\n    validation_error: err,\n  },\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        0
      ],
