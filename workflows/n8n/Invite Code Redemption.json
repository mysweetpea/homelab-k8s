    {
      "parameters": {
        "jsCode": "const item = $input.first();\nconst chars = 'ABCDEFGHJKLMNPQRSTUVWXYZabcdefghjkmnpqrstuvwxyz23456789!@#$%';\nlet pwd = '';\nfor (let i = 0; i < 16; i++) pwd += chars.charAt(Math.floor(Math.random() * chars.length));\nitem.json.temp_password = pwd;\nreturn [item];"
      },
